{
  "name": "bestword",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:packages": "tsc -b packages/contracts packages/engine packages/lexicon",
    "build": "npm run build:packages && npm run build -w @bestword/server && npm run build -w @bestword/web",
    "typecheck": "tsc -b && npm run typecheck -w @bestword/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run build:packages && concurrently -k \"tsc -b packages/contracts packages/engine packages/lexicon --watch\" \"npm run dev -w @bestword/server\" \"npm run dev -w @bestword/web\"",
    "start": "node apps/server/dist/index.js",
    "worker": "node apps/server/dist/worker.js",
    "test:e2e": "playwright test",
    "test:load": "node tools/load/run.mjs",
    "migrate": "node apps/server/dist/migrate.js",
    "dev:services": "node tools/dev/services.mjs start",
    "dev:services:status": "node tools/dev/services.mjs status",
    "dev:services:stop": "node tools/dev/services.mjs stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "^4.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
